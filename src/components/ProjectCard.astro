---
import type { CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';

export interface Props {
	project: CollectionEntry<'projects'>;
	index?: number;
}

const { project, index = 0 } = Astro.props;
const { title, description, tags, pubDate, cover } = project.data;

// Map cover key to generative SVG poster composition
const palette: Record<string, [string, string]> = {
	'motion-brand': ['#e85d3e', '#f5a623'],
	'tidal-doc': ['#26b6a8', '#1e62c9'],
	'sound-terrain': ['#9b5cf6', '#f25c54'],
	'neon-posters': ['#ff2e7e', '#6b2dff'],
	'ar-echo': ['#2fd889', '#22b6a8'],
};
const [c1, c2] = palette[cover ?? 'motion-brand'] ?? palette['motion-brand'];
const slug = project.id;
const num = String(index + 1).padStart(2, '0');
---

<article class="work">
	<a class="cover" href={`/projects/${slug}`} aria-label={`${title} 作品详情`}>
		<CoverArt cover={cover} c1={c1} c2={c2} slug={slug} />
		<span class="view">查看 →</span>
	</a>

	<div class="meta">
		<div class="row">
			<span class="num">{num}</span>
			<time class="year" datetime={pubDate.toISOString()}>
				{pubDate.getFullYear()}
			</time>
		</div>
		<h2 class="title"><a href={`/projects/${slug}`}>{title}</a></h2>
		{
			tags.length > 0 && (
				<p class="tags">{tags.join(' · ')}</p>
			)
		}
	</div>
</article>

<style>
	.work {
		display: flex;
		flex-direction: column;
	}

	.cover {
		position: relative;
		display: block;
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: var(--radius);
		background: #000;
		box-shadow: var(--shadow-md);
	}
	.cover :global(.cover-art) {
		transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
	}
	.work:hover .cover :global(.cover-art) {
		transform: scale(1.04);
	}

	.view {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		padding: 18px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		color: #fff;
		background: linear-gradient(to top, rgba(0,0,0,0.35), transparent 45%);
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.work:hover .view {
		opacity: 1;
	}

	.meta {
		padding: 16px 4px 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.row {
		display: flex;
		align-items: baseline;
		gap: 10px;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-dim);
	}
	.num {
		color: var(--accent);
	}

	.title {
		font-family: var(--font-display);
		font-size: clamp(18px, 1.6vw, 22px);
		font-weight: 600;
		line-height: 1.3;
		margin: 0;
	}
	.title a {
		color: var(--fg);
		transition: color 0.2s;
	}
	.title a:hover {
		color: var(--accent);
	}

	.tags {
		font-size: 13px;
		color: var(--fg-muted);
		margin: 0;
	}
</style>
