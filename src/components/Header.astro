---
import { Icon } from 'astro-icon/components';

export interface Props {
	autohide?: boolean;
}
const { autohide = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);

const nav = [
	{ href: '/', label: '关于我', icon: 'lucide:fingerprint' },
	{ href: '/projects', label: '作品', icon: 'lucide:palette' },
	{ href: '/contact', label: '联系', icon: 'lucide:feather' },
];

// ── 移动端：小程序式底部 TabBar ──
const tabs = [
	{ href: '/', label: '关于我', icon: 'lucide:fingerprint' },
	{ href: '/projects', label: '作品', icon: 'lucide:palette' },
	{ href: '/contact', label: '联系', icon: 'lucide:mail' },
];

const isHome = path === '/';

// 小程序导航栏标题；动态详情页标题由 JS 从 <title> 补充
const TITLES: Record<string, string> = {
	'/': '关于我',
	'/projects': '作品',
	'/projects/video': '短视频剪辑',
	'/projects/graphic': '平面视觉设计',
	'/projects/3d': '三维基础创作',
	'/huihua': '绘画习作',
	'/sheying': '摄影',
	'/lianxi': '练习',
	'/contact': '联系与简历',
	'/suitanglianxi': 'UI 界面设计',
	'/suitanglianxi/upan': 'U盘',
	'/suitanglianxi/fengmi': '蜂蜜',
	'/suitanglianxi/naaisi': '纳爱斯',
	'/suitanglianxi/yzgirl': '英州姑娘',
};
const navTitle = TITLES[path] ?? '';
---

<header class="site-header" data-autohide={autohide ? 'true' : undefined}>
	<!-- 移动端：小程序式导航栏 -->
	<div class="mini-nav">
		<button class="mini-back" type="button" aria-label="返回" hidden={isHome}>
			<Icon name="lucide:chevron-left" size={22} />
		</button>
		<span class="mini-title">{navTitle}</span>
	</div>

	<div class="container bar">
		<a class="brand" href="/" aria-label="返回首页">
			<img class="mark" src="/images/logo.webp" alt="" aria-hidden="true" />
			<span class="brand-text">liuyingying</span>
		</a>

		<button
			class="menu-toggle"
			type="button"
			aria-label="切换导航"
			aria-expanded="false"
			aria-controls="primary-nav"
		>
			<span class="menu-bar"></span>
			<span class="menu-bar"></span>
		</button>

		<nav id="primary-nav" class="primary-nav" aria-label="主导航">
			{
				nav.map((item) => {
					const color =
						item.href === '/' ? 'blue' :
						item.href === '/projects' ? 'yellow' : 'red';
					return (
						<a
							class:list={['nav-link', { active: isActive(item.href) }]}
							href={item.href}
							aria-current={isActive(item.href) ? 'page' : undefined}
							data-color={color}
						>
							<Icon name={item.icon} size={16} />
							{item.label}
						</a>
					);
				})
			}
		</nav>
	</div>
</header>

<!-- 移动端：底部 TabBar（独立于 header，避免被 header 的 transform 影响定位） -->
<nav class="tabbar" aria-label="底部导航">
	{
		tabs.map((t) => (
			<a
				class:list={['tab', { active: isActive(t.href) }]}
				href={t.href}
				aria-current={isActive(t.href) ? 'page' : undefined}
			>
				<Icon name={t.icon} size={22} />
				<span>{t.label}</span>
			</a>
		))
	}
</nav>

<style>
	/* ── 默认粘性顶栏（所有页面） ── */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 72%, transparent);
		backdrop-filter: blur(28px) saturate(160%);
		border-bottom: 1px solid var(--line-strong);
	}

	/* ── 首页自动隐藏模式 ── */
	.site-header[data-autohide="true"] {
		position: fixed;
		left: 0;
		right: 0;
		transform: translateY(-100%);
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		pointer-events: none;
	}
	.site-header[data-autohide="true"][data-visible="true"] {
		transform: translateY(0);
		pointer-events: auto;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 72px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-family: var(--font-mono);
		font-size: 13px;
		letter-spacing: 0.06em;
		color: var(--fg);
		text-transform: uppercase;
	}
	.brand:focus-visible {
		outline: none;
	}

	.mark {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		object-fit: cover;
		display: block;
	}

	.primary-nav {
		display: flex;
		align-items: center;
		gap: 4px;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		font-weight: 500;
		color: var(--fg-muted);
		padding: 8px 2px;
		margin: 0 12px;
		position: relative;
		transition: color 0.2s;
	}
	.nav-link::after {
		content: '';
		position: absolute;
		bottom: -2px;
		left: 0;
		width: 100%;
		height: 2px;
		background: var(--accent-blue);
		transform: scaleX(0);
		transition: transform 0.2s, background 0.2s;
	}
	.nav-link:focus-visible {
		outline: none;
	}
	/* ── 每个链接各自的颜色（悬浮、聚焦、选中） ── */
	.nav-link[data-color="blue"]:hover,
	.nav-link[data-color="blue"]:focus-visible,
	.nav-link[data-color="blue"].active {
		color: var(--accent-blue);
	}
	.nav-link[data-color="blue"]:hover::after,
	.nav-link[data-color="blue"]:focus-visible::after,
	.nav-link[data-color="blue"].active::after {
		background: var(--accent-blue);
		transform: scaleX(1);
	}
	.nav-link[data-color="yellow"]:hover,
	.nav-link[data-color="yellow"]:focus-visible,
	.nav-link[data-color="yellow"].active {
		color: var(--accent-yellow);
	}
	.nav-link[data-color="yellow"]:hover::after,
	.nav-link[data-color="yellow"]:focus-visible::after,
	.nav-link[data-color="yellow"].active::after {
		background: var(--accent-yellow);
		transform: scaleX(1);
	}
	.nav-link[data-color="red"]:hover,
	.nav-link[data-color="red"]:focus-visible,
	.nav-link[data-color="red"].active {
		color: var(--accent-red);
	}
	.nav-link[data-color="red"]:hover::after,
	.nav-link[data-color="red"]:focus-visible::after,
	.nav-link[data-color="red"].active::after {
		background: var(--accent-red);
		transform: scaleX(1);
	}


	.menu-toggle {
		display: none;
		width: 40px;
		height: 40px;
		border: 1px solid var(--line);
		background: transparent;
		border-radius: 10px;
		cursor: pointer;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 5px;
	}

	.menu-bar {
		width: 18px;
		height: 2px;
		background: var(--fg);
		border-radius: 2px;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.menu-toggle[aria-expanded='true'] .menu-bar:nth-child(1) {
		transform: translateY(3.5px) rotate(45deg);
	}
	.menu-toggle[aria-expanded='true'] .menu-bar:nth-child(2) {
		transform: translateY(-3.5px) rotate(-45deg);
	}

	/* ── 移动端的小程序式元素默认隐藏 ── */
	.mini-nav,
	.tabbar {
		display: none;
	}

	/* ── 移动端：小程序化布局 ── */
	@media (max-width: 720px) {
		.site-header {
			position: fixed;
			left: 0;
			right: 0;
			transform: none;
			pointer-events: auto;
			z-index: 60;
			background: rgba(255, 255, 255, 0.92);
			backdrop-filter: blur(24px) saturate(160%);
			border-bottom: 1px solid rgba(0, 0, 0, 0.06);
		}
		/* 首页 autohide 在移动端关闭：导航栏常驻顶部 */
		.site-header[data-autohide="true"] {
			transform: none;
			pointer-events: auto;
		}
		.bar,
		.menu-toggle,
		.primary-nav {
			display: none;
		}

		/* 导航栏：居中标题 + 左侧返回 + 右侧胶囊 */
		.mini-nav {
			display: flex;
			align-items: center;
			justify-content: center;
			position: relative;
			height: calc(46px + env(safe-area-inset-top));
			padding-top: env(safe-area-inset-top);
			box-sizing: border-box;
		}
		.mini-title {
			font-size: 16px;
			font-weight: 600;
			color: var(--fg);
			letter-spacing: 0.01em;
			max-width: 52%;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.mini-back {
			position: absolute;
			left: 8px;
			top: calc(env(safe-area-inset-top) + 5px);
			display: flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: 36px;
			border: none;
			background: rgba(0, 0, 0, 0.04);
			color: var(--fg);
			border-radius: 50%;
			-webkit-tap-highlight-color: transparent;
			transition: background 0.15s;
		}
		.mini-back:active {
			background: rgba(0, 0, 0, 0.1);
		}
		.mini-back[hidden] {
			display: none;
		}

		/* 底部 TabBar */
		.tabbar {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			position: fixed;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 60;
			background: rgba(255, 255, 255, 0.96);
			backdrop-filter: blur(24px) saturate(160%);
			border-top: 1px solid rgba(0, 0, 0, 0.06);
			box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.04);
			padding-bottom: env(safe-area-inset-bottom);
		}
		.tab {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 3px;
			padding: 7px 0 6px;
			font-size: 11px;
			font-weight: 500;
			color: var(--fg-dim);
			-webkit-tap-highlight-color: transparent;
			transition: color 0.2s;
		}
		.tab.active {
			color: var(--accent);
		}
		.tab :global(svg) {
			transition: transform 0.2s;
		}
		.tab.active :global(svg) {
			transform: translateY(-1px);
		}
	}
</style>

<script is:inline>
	(function () {
		// ── 小程序导航栏标题（动态详情页从 <title> 读取） ──
		const titleEl = document.querySelector('.mini-title');
		if (titleEl && !titleEl.textContent.trim()) {
			const t = (document.title || '').split('—')[0].trim();
			if (t) titleEl.textContent = t;
		}

		// ── 小程序返回按钮（有历史则返回，否则回首页） ──
		const backBtn = document.querySelector('.mini-back');
		if (backBtn) {
			backBtn.addEventListener('click', () => {
				if (window.history.length > 1) {
					window.history.back();
				} else {
					window.location.href = '/';
				}
			});
		}

		// ── Hamburger（桌面端） ──
		const btn = document.querySelector('.menu-toggle');
		const nav = document.getElementById('primary-nav');
		if (btn && nav) {
			btn.addEventListener('click', () => {
				const open = btn.getAttribute('aria-expanded') === 'true';
				btn.setAttribute('aria-expanded', String(!open));
				nav.dataset.open = String(!open);
			});
			nav.addEventListener('click', (e) => {
				if (e.target instanceof HTMLAnchorElement) {
					btn.setAttribute('aria-expanded', 'false');
					nav.dataset.open = 'false';
				}
			});
		}
	})();
</script>