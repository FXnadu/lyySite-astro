---
import { Icon } from 'astro-icon/components';
import fs from 'node:fs';
const year = new Date().getFullYear();

const resumeFiles = fs.readdirSync('public/resume').filter((f) => f.endsWith('.pdf')).sort();
const resumePath = resumeFiles[0] ? `/resume/${resumeFiles[0]}` : null;
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-card">
			<div class="brand-group">
				<div class="brand">
					<h2 class="name">liuyingying</h2>
					<p class="tagline">数字媒体 · 个人网站</p>
				</div>
			</div>
			<div class="actions">
				{resumePath && (
					<a class="contact-btn" href={resumePath} download aria-label="下载 PDF 简历" title="下载 PDF 简历">
						<Icon name="lucide:download" size={20} />
					</a>
				)}
				<a class="contact-btn" href="/contact" aria-label="联系我" title="联系我">
					<Icon name="lucide:mail" size={20} />
				</a>
			</div>
		</div>

		<div class="bottom">
			<p class="copy">© {year} liuyingying · Built with Astro · Design by lyy</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		border-top: 1px solid var(--line);
		padding-block: 36px 28px;
	}
	.site-footer::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(circle at 10% 100%, color-mix(in srgb, var(--accent) 5%, transparent) 0%, transparent 28%),
			radial-gradient(circle at 90% 10%, color-mix(in srgb, var(--accent) 4%, transparent) 0%, transparent 22%);
	}

	.container {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	.footer-card {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		padding: 20px;
		background: transparent;
		border-radius: 20px;
		position: relative;
	}

	.brand-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.name {
		margin: 0 0 6px;
		font-size: 22px;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--fg);
	}

	.tagline {
		margin: 0;
		font-size: 14px;
		color: var(--fg-muted);
	}

	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
		padding-inline: 20px;
	}

	.copy {
		margin: 0;
		font-size: 13px;
		color: var(--fg-dim);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.contact-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 10%, transparent);
		border: 1.5px solid var(--accent);
		border-radius: 12px;
		box-shadow: 3px 3px 0 0 var(--accent);
		transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.2s ease;
		flex-shrink: 0;
	}
	.contact-btn:hover {
		transform: translate(1px, 1px);
		box-shadow: 2px 2px 0 0 var(--accent);
	}
	.contact-btn:active {
		transform: translate(3px, 3px);
		box-shadow: 0 0 0 0 var(--accent);
	}

	@media (max-width: 720px) {
		.site-footer {
			padding-block: 20px 16px;
			border-top-color: transparent;
		}
		.site-footer::before {
			display: none;
		}
		.footer-card {
			flex-direction: column;
			align-items: center;
			gap: 16px;
			padding: 16px;
		}
		.brand-group {
			align-items: center;
			text-align: center;
		}
		.name { font-size: 20px; }
		.bottom {
			flex-direction: column;
			align-items: center;
			padding-inline: 16px;
			gap: 8px;
		}
		.copy { text-align: center; }
		/* 操作按钮组（下载简历/联系我）移动端隐藏 */
		.actions {
			display: none;
		}
	}
</style>
