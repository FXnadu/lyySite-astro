---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import fs from 'node:fs';

const projects = await getCollection('projects', (entry) => entry.data.featured);

const featured = [...projects]
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
	.slice(0, 3);

const resumeFiles = fs.readdirSync('public/resume').filter((f) => f.endsWith('.pdf')).sort();
const resumePath = resumeFiles[0] ? `/resume/${resumeFiles[0]}` : null;

---

<Layout autohideHeader={true}>
	<!-- HERO -->
	<section class="hero">
		<div class="container hero-grid">
			<div class="hero-text">
				<h1 class="title">
					liuyingying（lyy）<br />
					<span class="subtitle">数字媒体技术</span>
				</h1>
				<p class="lede">
					本人为 27 届数字媒体技术专业学生，熟练运用 PR、剪映进行短视频批量剪辑；精通 PS、AI 完成海报、图标、UI 界面及小红书封面设计，可借助 AI 工具辅助创作；掌握 3dmax、Maya 基础三维制作，具备扎实的色彩与平面构成审美，拥有线上短视频代剪、账号运营兼职经验，适配各类内容制作需求。
				</p>

				{resumePath && (
					<div class="cta">
						<a class="btn" href={resumePath} download>
							<Icon name="lucide:download" size={18} />
							下载 PDF 简历
						</a>
					</div>
				)}

			</div>


		</div>
	</section>

	<!-- ABOUT -->
	<section class="about" id="about">
		<div class="container">
			<header class="section-head">
				<h2><Icon name="lucide:notebook-pen" size={24} /> 简述</h2>
			</header>
			<div class="grid">
			<aside class="info">
				<div class="avatar">
					<img src="/images/logo.webp" alt="liuyingying 头像" width="96" height="96" />
				</div>
				<h2>信息</h2>
				<dl>
					<dt>专业</dt><dd>数字媒体技术</dd>
					<dt>方向</dt><dd>短视频剪辑、平面视觉设计</dd>
					<dt>毕业</dt><dd>2027 届</dd>
					<dt>城市</dt><dd>广东 / 求职中</dd>
				</dl>
				<h2>个人简介</h2>
				<p>27 届数字媒体技术在校生，熟练使用 PR、剪映进行短视频剪辑；掌握 PS、AI 平面设计与 UI 制作，具备线上短视频批量剪辑兼职经验，拥有良好审美，学习适应能力强。</p>
			</aside>
		</div>
		</div>
	</section>

	<!-- FEATURED -->
	<section class="featured">
		<div class="container">
			<header class="section-head">
				<h2><Icon name="lucide:sparkle" size={24} /> 精选作品</h2>
				<a class="more" href="/projects">查看全部 →</a>
			</header>
			<ul class="featured-list">
				{
					featured.map((project) => (
						<li>
							<a href={`/projects/${project.id}`}>
								<span class="title">{project.data.title}</span>
								<time class="date" datetime={project.data.pubDate.toISOString()}>
									{project.data.pubDate.toLocaleDateString('zh-CN', {
										year: 'numeric',
										month: '2-digit',
									})}
								</time>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

</Layout>

<script is:inline>
	(function () {
		// 首页顶栏自动隐藏：滚动经过 banner 后再出现
		const header = document.querySelector('.site-header');
		const hero = document.querySelector('.hero');
		if (!header || !hero) return;

		header.dataset.visible = 'false';

		const observer = new IntersectionObserver(
			([entry]) => {
				header.dataset.visible = String(!entry.isIntersecting);
			},
			{ threshold: 0 }
		);
		observer.observe(hero);
	})();
</script>

<style>
	.hero {
		min-height: 100vh;
		min-height: 100svh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-block: calc(72px + clamp(48px, 8vw, 88px)) clamp(40px, 5vw, 64px);
		overflow: hidden;
		position: relative;
		background: linear-gradient(135deg, var(--accent-pink) 0%, #f9a8d4 100%);
		color: #fff;
	}
	.hero::before {
		content: '';
		position: absolute;
		z-index: 0;
		top: -20%;
		right: -6%;
		width: 420px;
		height: 420px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255,255,255,0.16) 0%, transparent 70%);
		pointer-events: none;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		width: 100%;
	}
	.hero-text {
		max-width: 760px;
		position: relative;
		z-index: 1;
	}

	.title {
		font-family: var(--font-display);
		font-size: clamp(40px, 6vw, 76px);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin: 0 0 24px;
	}

	.subtitle {
		font-size: 0.45em;
		font-weight: 400;
		color: rgba(255,255,255,0.72);
	}

	.lede {
		font-size: clamp(16px, 1.6vw, 19px);
		color: rgba(255,255,255,0.82);
		line-height: 1.75;
		max-width: 50ch;
		margin-bottom: 28px;
	}

	.cta {
		display: flex;
		gap: 28px;
		align-items: center;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 500;
		color: #fff;
		padding-bottom: 3px;
		border-bottom: 2px solid rgba(255,255,255,0.42);
		transition: gap 0.25s, border-color 0.25s;
	}
	.btn:hover {
		gap: 14px;
		border-color: rgba(255,255,255,0.9);
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		margin-bottom: 36px;
		flex-wrap: wrap;
	}
	.section-head h2 {
		display: inline-flex;
		align-items: baseline;
		gap: 10px;
		font-family: var(--font-display);
		font-weight: 500;
		font-size: clamp(26px, 4vw, 40px);
		margin: 0;
	}
	.section-head h2 :global(svg) {
		transform: translateY(2px);
	}

	.index {
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--fg-dim);
		letter-spacing: 0.04em;
	}

	/* About */
	.about {
		padding-block: clamp(48px, 7vw, 72px);
		border-bottom: 1px solid var(--line);
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 48px;
		align-items: start;
	}
	.info h2 {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 600;
		color: var(--fg);
		letter-spacing: 0.06em;
		text-transform: uppercase;
		margin: 0 0 20px;
	}
	.info h2:not(:first-of-type) {
		margin-top: 24px;
	}
	.info p {
		font-size: 14px;
		color: var(--fg);
		line-height: 1.75;
		margin: 0;
	}
	.info {
		padding: 28px 28px 26px;
		background: transparent;
		border: 1px solid var(--line-strong);
		border-radius: 16px;
		box-shadow: 0 2px 16px rgba(0, 0, 0, 0.04);
		position: relative;
	}
	.avatar {
		display: flex;
		justify-content: center;
		margin-bottom: 20px;
	}
	.avatar img {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		border: 2px solid var(--line-strong);
		padding: 3px;
		background: var(--surface);
	}
	.info dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 10px 16px;
		margin: 0;
	}
	.info dt {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		color: var(--accent);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding-top: 4px;
	}
	.info dd {
		margin: 0;
		color: var(--fg);
		font-size: 14px;
	}

	/* Featured */
	.featured {
		padding-block: clamp(48px, 7vw, 72px);
		border-bottom: 1px solid var(--line);
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--accent);
		padding: 8px 16px;
		border: 1.5px solid var(--accent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 8%, transparent);
		box-shadow: 3px 3px 0 0 var(--accent);
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.more:hover {
		transform: translate(1px, 1px);
		box-shadow: 2px 2px 0 0 var(--accent);
	}
	.more:active {
		transform: translate(3px, 3px);
		box-shadow: 0 0 0 0 var(--accent);
	}

	.featured-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.featured-list li {
		border-bottom: 1px solid var(--line);
	}
	.featured-list li:last-child {
		border-bottom: none;
	}
	.featured-list a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		padding: 16px 0;
		font-size: 17px;
		color: var(--fg);
		text-decoration: none;
		transition: color 0.2s;
	}
	.featured-list a:hover {
		color: var(--accent);
	}
	.featured-list .title {
		font-weight: 500;
	}
	.featured-list .date {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--fg-dim);
		flex-shrink: 0;
	}

	@media (max-width: 960px) {
		.hero-grid { grid-template-columns: 1fr; }
		.grid { grid-template-columns: 1fr; gap: 24px; }
	}
</style>